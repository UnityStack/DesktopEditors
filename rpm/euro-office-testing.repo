# Euro-Office Community Edition (unofficial build by UnityStack GmbH), testing channel.
# dnf: /etc/yum.repos.d/euro-office.repo, zypper: /etc/zypp/repos.d/euro-office.repo
# Key fingerprint: 62E16713F4459962B0202B01038AB9E63A2B29ED
[euro-office-testing]
name=Euro-Office Community Edition testing (UnityStack GmbH)
baseurl=https://packages.unitystack.eu/euro-office/rpm/testing/
enabled=1
gpgcheck=1
repo_gpgcheck=1
# zypper checks package signatures only with this (dnf: gpgcheck=1)
pkg_gpgcheck=1
gpgkey=https://packages.unitystack.eu/keys/unitystack.asc
metadata_expire=6h
type=rpm-md
autorefresh=1
