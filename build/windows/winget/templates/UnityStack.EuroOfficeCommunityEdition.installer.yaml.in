# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.28.0.schema.json

PackageIdentifier: UnityStack.EuroOfficeCommunityEdition
PackageVersion: @VERSION@
InstallerLocale: en-US
InstallerType: inno
Scope: machine
InstallModes:
- interactive
- silent
- silentWithProgress
UpgradeBehavior: install
ElevationRequirement: elevatesSelf
ProductCode: Euro-Office Desktop Editors_is1
ReleaseDate: @RELEASE_DATE@
InstallationMetadata:
  DefaultInstallLocation: '%ProgramFiles%\Euro-Office\DesktopEditors'
Installers:
- Architecture: x64
  InstallerUrl: @X64_URL@
  InstallerSha256: @X64_SHA256@
  AppsAndFeaturesEntries:
  - DisplayName: Euro-Office (Standalone) @SHORT_VERSION@ (x64)
    Publisher: Euro-Office
    DisplayVersion: @VERSION@
    ProductCode: Euro-Office Desktop Editors_is1
- Architecture: arm64
  InstallerUrl: @ARM64_URL@
  InstallerSha256: @ARM64_SHA256@
  AppsAndFeaturesEntries:
  - DisplayName: Euro-Office (Standalone) @SHORT_VERSION@ (arm64)
    Publisher: Euro-Office
    DisplayVersion: @VERSION@
    ProductCode: Euro-Office Desktop Editors_is1
ManifestType: installer
ManifestVersion: 1.28.0
