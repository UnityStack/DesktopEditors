# Euro-Office Community Edition (unofficial build by UnityStack GmbH), @CHANNEL@ channel.
# dnf: /etc/yum.repos.d/euro-office.repo, zypper: /etc/zypp/repos.d/euro-office.repo
# Key fingerprint: @KEY_FPR@
[@REPO_ID@]
name=@REPO_NAME@
baseurl=@BASE_URL@/rpm/@CHANNEL@/
enabled=1
gpgcheck=1
repo_gpgcheck=1
# zypper checks package signatures only with this (dnf: gpgcheck=1)
pkg_gpgcheck=1
gpgkey=@BASE_URL@/keys/euro-office.asc
metadata_expire=6h
type=rpm-md
autorefresh=1
