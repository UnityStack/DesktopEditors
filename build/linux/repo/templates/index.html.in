<style>
  :root {
    --bg: #ffffff; --fg: #1d1f23; --muted: #5d6470; --line: #dfe2e7;
    --code-bg: #f4f5f7; --accent: #1f5fbf; --note-bg: #fff8e1; --note-line: #f0c36d;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #15171b; --fg: #e6e8eb; --muted: #a2a9b4; --line: #2c3038;
      --code-bg: #1e2127; --accent: #7aa7ff; --note-bg: #2a2416; --note-line: #7a6326;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  main { max-width: 46rem; margin: 0 auto; padding: 2.5rem 16px 4rem; }
  h1 { font-size: 1.75rem; margin: 0 0 .25rem; }
  h2 { font-size: 1.2rem; margin: 2.25rem 0 .5rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  h3 { font-size: 1rem; margin: 1.25rem 0 .25rem; }
  p, li { color: var(--fg); }
  .lead { color: var(--muted); margin-top: 0; }
  .note { background: var(--note-bg); border-left: 4px solid var(--note-line); padding: .6rem .9rem; border-radius: 4px; }
  pre, code { font: 13.5px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  code { background: var(--code-bg); padding: .05rem .3rem; border-radius: 3px; overflow-wrap: anywhere; }
  pre { background: var(--code-bg); padding: .75rem .9rem; border-radius: 6px; overflow-x: auto; }
  pre code { background: none; padding: 0; }
  a { color: var(--accent); }
  table { border-collapse: collapse; width: 100%; }
  td, th { text-align: left; padding: .3rem .5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
