+Requires: libnss3.so()(64bit), libnspr4.so()(64bit), libsmime3.so()(64bit), libnssutil3.so()(64bit), libasound.so.2()(64bit), libgbm.so.1()(64bit), libdrm.so.2()(64bit), libX11-xcb.so.1()(64bit), libGL.so.1()(64bit), libEGL.so.1()(64bit), libOpenGL.so.0()(64bit), libpulse.so.0()(64bit)
