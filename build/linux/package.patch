 %if "%{_package_edition}" == "full"
 Requires: curl, libX11, xdg-utils, dejavu-sans-fonts, dejavu-sans-mono-fonts, dejavu-serif-fonts, liberation-mono-fonts, liberation-sans-fonts, liberation-serif-fonts
