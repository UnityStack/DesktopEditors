+%post
+# Registers the signed repository once, like Chrome does: if no repo file
+# points at it yet and the admin did not opt out, write one for zypper or dnf
+# and record repo_add="false" in the defaults file, so a removed repo file is
+# not recreated by later upgrades. Opt-out before installing: an empty
+# defaults file or one containing repo_add="false". The key is payload
+# (gpgkey below); dnf/zypper import it on first use, never this scriptlet.
+# It is UnityStack's key, the same for the repositories of its other
+# products, so its file and URL are not named after this product.
+# pkg_gpgcheck: with a signed repomd.xml zypper skips the package signature
+# unless it is set (dnf ignores it, gpgcheck covers dnf).
+defaults=/etc/default/%{_repo_name}
+header="Written by the %{_package_name} package."
+repo_uri=%{_repo_url}/rpm
+# Prereleases come from the testing channel (stable + prereleases).
+case "%{version}-%{release}" in
+  *~rc*|*~beta*|*~alpha*) channel=testing; repo_id=%{_repo_name}-testing; name_suffix=" - testing" ;;
+  *) channel=stable; repo_id=%{_repo_name}; name_suffix= ;;
+esac
+# By distribution, not by which directory exists: Fedora's zypper package
+# creates /etc/zypp/repos.d too, and dnf never reads it.
+if [ -d /etc/zypp/repos.d ] && { grep -qsiE '^ID(_LIKE)?=.*suse' /etc/os-release || [ ! -d /etc/yum.repos.d ]; }; then
+  repo_file=/etc/zypp/repos.d/%{_repo_name}.repo
+else
+  repo_file=/etc/yum.repos.d/%{_repo_name}.repo
+fi
+repo_add=
+if [ -f "$defaults" ] && [ ! -s "$defaults" ]; then
+  repo_add=false
+elif [ -f "$defaults" ]; then
+  repo_add=$(sed -n 's/^[[:space:]]*repo_add=//p' "$defaults" | tail -n 1 | tr -d "\"' ")
+fi
+if [ "$repo_add" != "false" ] && [ -d "$(dirname "$repo_file")" ]; then
+  if ! grep -rqsF "${repo_uri#*://}" /etc/yum.repos.d /etc/zypp/repos.d; then
+    cat > "$repo_file.rpmtmp" <<EOF
+# $header Remove this file to stop
+# updates; it is not recreated (set repo_add="false" in $defaults).
+[$repo_id]
+name=%{_company_name} Community Edition (%{_publisher_name})$name_suffix
+baseurl=$repo_uri/$channel/
+enabled=1
+gpgcheck=1
+repo_gpgcheck=1
+pkg_gpgcheck=1
+gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-%{_repo_key_name} %{_repo_key_url}
+metadata_expire=6h
+type=rpm-md
+autorefresh=1
+EOF
+    chmod 0644 "$repo_file.rpmtmp"
+    mv -f "$repo_file.rpmtmp" "$repo_file"
+  fi
+  if [ ! -e "$defaults" ]; then
+    mkdir -p /etc/default
+    cat > "$defaults" <<EOF
+# $header
+# repo_add="false": the package does not (re)create its repository file
+# ($repo_file). Delete this file to have the next install or upgrade add
+# the repository again.
+repo_add="false"
+EOF
+  elif grep -q '^[[:space:]]*repo_add=' "$defaults"; then
+    sed -i 's/^\([[:space:]]*\)repo_add=.*/\1repo_add="false"/' "$defaults"
+  else
+    echo 'repo_add="false"' >> "$defaults"
+  fi
+fi
+
 %postun
 rm -f /usr/share/mime/packages/onlyoffice-docxf.xml
 rm -f /usr/share/mime/packages/onlyoffice-oform.xml
+if [ "$1" = 0 ]; then
+  # Erase (not upgrade): drop what the install scriptlet wrote, if it is
+  # still ours. An admin's own defaults file (opt-out) stays, and so does
+  # the imported key (gpg-pubkey): other UnityStack repositories use it.
+  for f in /etc/yum.repos.d/%{_repo_name}.repo /etc/zypp/repos.d/%{_repo_name}.repo /etc/default/%{_repo_name}; do
+    if grep -qsF "Written by the %{_package_name} package." "$f"; then
+      rm -f "$f"
+    fi
+  done
+fi
 
 %changelog
 
